-- Dataform ELT model definitions (SQLX) — version-controlled, dependency-graphed
-- BigQuery transformations with built-in assertions (data-quality tests).
-- This is the "modeling" layer of the reference architecture; Dataform compiles
-- the ref() graph and orchestrates incremental builds.

-- ============================ staging ============================
config { type: "view", schema: "staging", description: "Cleaned repair-order events" }

SELECT
  ro_number,
  CAST(dealer_key AS INT64)          AS dealer_key,
  DATE(service_date)                 AS service_date,
  service_type,
  CAST(total_amount AS NUMERIC)      AS total_amount,
  satisfaction_score
FROM ${ref("raw", "service_events")}
WHERE ro_number IS NOT NULL
  AND total_amount >= 0

